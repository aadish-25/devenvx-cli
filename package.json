{
  "name": "devenvx",
  "version": "1.0.0",
  "description": "DevEnvx is a zero-install CLI tool that sets up full development environments (Python, Java, C++, and more) on Windows using one simple command. No downloads, no browser — just run and code.",
  "main": "./cli/main.js",
  "type": "module",
  "os": [
    "win32"
  ],
  "bin": {
    "devenvx": "./cli/index.js"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node ./cli/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aadish-25/devenvx-cli.git"
  },
  "keywords": [
    "cli",
    "development",
    "environment",
    "setup",
    "windows",
    "installer",
    "python",
    "java",
    "cpp"
  ],
  "author": {
    "name": "Aadish Sonawane",
    "url": "https://github.com/aadish-25"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aadish-25/devenvx-cli/issues"
  },
  "homepage": "https://github.com/aadish-25/devenvx-cli#readme",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "figlet": "^1.8.1",
    "nanospinner": "^1.2.2"
  }
}
